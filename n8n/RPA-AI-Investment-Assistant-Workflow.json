    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // Pega os dados brutos da IA\n  let text = item.json.content?.parts?.[0]?.text || item.json.text || \"\";\n\n  // Remove formatações Markdown do JSON\n  text = text.replace(/```json\\s*/g, \"\").replace(/```\\s*/g, \"\").trim();\n\n  let parsed = {};\n  try {\n    parsed = JSON.parse(text);\n  } catch (e) {\n    parsed = {\n      subject: \"Oportunidade de Investimento\",\n      text_body: text,\n      html_body: `<p>${text}</p>`\n    };\n  }\n\n  // Pega as informações do cliente vindas do nó anterior (se existirem)\n  const j = item.json;\n\n  return {\n    json: {\n      ok: true,\n      to: j.email || j.to || \"\",\n      subject: parsed.subject || \"\",\n      text_body: parsed.text_body || \"\",\n      html_body: parsed.html_body || \"\",\n      meta: {\n        nome: j.nome,\n        perfil: j.perfil,\n        produto: j.recomendacao?.produto,\n        minimo: j.recomendacao?.minimo,\n        rentabilidade: j.recomendacao?.rentabilidade,\n        motivo: j.motivo\n      }\n    }\n  };\n});"
      },
