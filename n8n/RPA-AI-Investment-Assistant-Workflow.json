      "name": "Buscar Catálogo de Produtos"
    },
    {
      "parameters": {
        "jsCode": "// Pega o CSV como texto vindo do HTTP Request\nconst csvRaw = $json.data ?? $json.body ?? $json;\nconst text = (typeof csvRaw === \"string\") ? csvRaw : JSON.stringify(csvRaw);\n\nconst lines = text.split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\nconst headers = lines[0].split(\",\").map(h => h.trim());\n\nconst investimentos = lines.slice(1).map(line => {\n  const cols = line.split(\",\").map(c => c.trim());\n  const obj = {};\n  headers.forEach((h, i) => obj[h] = cols[i] ?? \"\");\n\n  // normaliza mínimo para número\n  obj.minimo = Number(String(obj.minimo).replace(/[^\\d]/g, \"\")) || 0;\n\n  return obj;\n});\n\nreturn [{ json: { investimentos } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "fd2aca05-9dab-4e55-8b0d-667412fc5f5f",
      "name": "Parsear Catálogo JSON"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        608,
        -128
      ],
      "id": "611c389b-eab6-4522-bd02-654e6936cf58",
      "name": "Consolidar Dados (Entrada + Produtos)"
    },
    {
      "parameters": {
        "jsCode": "function pick(arr) {\n  return arr[Math.floor(Math.random() * arr.length)];\n}\n\n// Extrai clientes do body e investimentos do objeto raiz\nconst clientes = $input.first().json.body?.clientes || [];\nconst investimentos = $input.first().json.investimentos || [];\n\nconst resultados = clientes.map(function(c) {\n  const nome = c.nome;\n  const email = c.email;\n  const perfil = c.perfil;\n  \n  // Trata o valor numérico do saldo\n  const saldoNum = Number(String(c.saldo).replace(/[^\\d]/g, \"\")) / 100 || 0;\n\n  // Busca o investimento correspondente ao perfil\n  const escolhido = investimentos.find(function(i) {\n    return String(i.perfil).toLowerCase() === String(perfil).toLowerCase();\n  }) || null;\n\n  let motivo = \"sem_investimento\";\n  let mensagens = [];\n\n  if (escolhido) {\n    if (saldoNum >= escolhido.minimo) {\n      motivo = \"saldo_ok\";\n      \n      const prod = escolhido.produto;\n      const minFormatado = \"R$ \" + Number(escolhido.minimo).toLocaleString(\"pt-BR\", { minimumFractionDigits: 2 });\n      const rent = escolhido.rentabilidade;\n      const saldoTexto = c.saldo;\n\n      mensagens = [\n        \"Olá \" + nome + \"! Pelo seu perfil (\" + perfil + \"), uma boa opção é **\" + prod + \"** (mínimo \" + minFormatado + \"). Com seu saldo atual (\" + saldoTexto + \"), você já consegue investir. Rentabilidade: \" + rent + \".\",\n        \"Oi \" + nome + \"! Recomendação para perfil \" + perfil + \": **\" + prod + \"** (mínimo \" + minFormatado + \"). Seu saldo (\" + saldoTexto + \") já atende o mínimo. Rentabilidade: \" + rent + \".\",\n        nome + \", indo direto ao ponto: para o perfil \" + perfil + \", **\" + prod + \"** (mínimo \" + minFormatado + \"). Você tem \" + saldoTexto + \", então dá pra aplicar. Rentabilidade: \" + rent + \".\"\n      ];\n    } else {\n      motivo = \"saldo_insuficiente\";\n      mensagens = [\n        \"Olá \" + nome + \", seu perfil é \" + perfil + \", mas o saldo atual (\" + c.saldo + \") está abaixo do mínimo necessário.\"\n      ];\n    }\n  }\n\n  return {\n    nome: nome,\n    email: email,\n    perfil: perfil,\n    saldo_texto: c.saldo,\n    saldo_num: saldoNum,\n    recomendacao: escolhido,\n    motivo: motivo,\n    mensagens: mensagens,\n    mensagem_escolhida: pick(mensagens)\n  };\n});\n\nreturn [{\n  json: {\n    ok: true,\n    total_clientes: resultados.length,\n    total_investimentos: investimentos.length,\n    resultados: resultados\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "id": "71d454b5-e711-4e9a-81e4-cb835f5876bb",
      "name": "Mapear Regras de Investimento"
    },
    {
      "parameters": {
        "jsCode": "const resultados = $json.resultados || [];\n\nfunction parseBRL(valor) {\n  if (!valor) return 0;\n  const s = String(valor)\n    .replace(\"R$\", \"\")\n    .replace(/\\./g, \"\")\n    .replace(\",\", \".\")\n    .replace(/[^\\d.]/g, \"\")\n    .trim();\n  const n = Number(s);\n  return Number.isFinite(n) ? n : 0;\n}\n\n// retorna UM ITEM por cliente\nconst out = resultados.map(c => {\n  const saldoNum = c.saldo_num ?? parseBRL(c.saldo_texto ?? c.saldo);\n\n  return {\n    json: {\n      email_to: String(c.email || \"\").trim(),\n      nome: String(c.nome || \"\").trim(),\n      perfil: c.perfil,\n      saldo_texto: c.saldo_texto ?? c.saldo,\n      saldo_num: saldoNum,\n      recomendacao: c.recomendacao,\n      motivo: c.motivo,\n      mensagem_base: c.mensagem_escolhida || c.mensagem || \"\",\n      copy_rules: {\n        idioma: \"pt-BR\",\n        tom: \"amigável e profissional\",\n        tamanho: \"curto (4-6 linhas)\",\n        evitar: [\"promessas de ganho\", \"garantias\", \"linguagem agressiva\"]\n      }\n    }\n  };\n});\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        0
      ],
      "id": "5b8876be-b5e4-400b-91f0-26e3466b8396",
      "name": "Montar Prompts para IA"
